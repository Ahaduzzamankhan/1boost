{
  "name": "1boost",
  "productName": "1Boost",
  "version": "1.3.2",
  "description": "1Boost — PC usage analytics for Windows",
  "author": "1Boost",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "native:build": "cargo build --release --manifest-path native/Cargo.toml",
    "native:build:dev": "cargo build --manifest-path native/Cargo.toml",
    "rust:test": "cargo test --release --manifest-path native/Cargo.toml",
    "build:renderer": "node scripts/build.mjs renderer",
    "build": "npm run typecheck && node scripts/build.mjs renderer",
    "dev": "node scripts/build.mjs renderer && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "icons:tray": "node scripts/make-tray-icons.mjs",
    "icons:tray:check": "node scripts/make-tray-icons.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons:tauri": "node scripts/make-tauri-icons.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
